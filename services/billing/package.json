{
  "name": "@opening-cross/billing",
  "version": "0.1.0",
  "private": true,
  "description": "The issuer subscription for managed recurring crosses: plans from the rate card, a payment built as an unsigned USDC transfer, proof of payment read back from the chain, entitlements, and signed invoices. It never gates the program: anyone can still create a cross on chain.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "tsx src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@opening-cross/attest": "workspace:*",
    "@opening-cross/fees": "workspace:*",
    "@solana-program/memo": "0.15.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.4.0",
    "fastify": "5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@opening-cross/indexer": "workspace:*",
    "@solana-program/system": "0.15.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
