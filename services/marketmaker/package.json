{
  "name": "@opening-cross/marketmaker",
  "version": "0.1.0",
  "private": true,
  "description": "The company's own market-maker bot: quotes two-sided limit orders into open crosses from its own budget, reveals sealed orders, claims fills, and reports its volume apart from everyone else's.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "tsx src/main.ts",
    "devnet-run": "tsx scripts/devnet-run.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@opening-cross/client": "workspace:*",
    "@opening-cross/liquidity": "workspace:*",
    "@opening-cross/sdk": "workspace:*",
    "@solana/kit": "8.4.0"
  },
  "devDependencies": {
    "@solana-program/system": "0.15.0",
    "@solana-program/token-2022": "0.19.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
