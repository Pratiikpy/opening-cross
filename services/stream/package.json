{
  "name": "@opening-cross/stream",
  "version": "0.1.0",
  "description": "A typed gRPC stream of every Opening Cross event: resumable from a cursor, filterable by cross and event, with the full history behind it, read from the indexer's database.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "tsx src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@opening-cross/cross-core-client": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@opening-cross/indexer": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
