{
  "name": "@opening-cross/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Indexer for Opening Cross: decodes cross_core events into Postgres and reconciles the database against chain state.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts",
    "devnet-check": "tsx scripts/devnet-check.ts",
    "test": "vitest run test"
  },
  "dependencies": {
    "@opening-cross/cross-backing-client": "workspace:*",
    "@opening-cross/cross-basket-client": "workspace:*",
    "@opening-cross/cross-bounty-client": "workspace:*",
    "@opening-cross/cross-calendar-client": "workspace:*",
    "@opening-cross/cross-conviction-client": "workspace:*",
    "@opening-cross/cross-core-client": "workspace:*",
    "@opening-cross/cross-graduate-client": "workspace:*",
    "@opening-cross/cross-listing-client": "workspace:*",
    "@opening-cross/cross-mandate-client": "workspace:*",
    "@opening-cross/cross-settle-client": "workspace:*",
    "@opening-cross/treasury-client": "workspace:*",
    "@solana/kit": "8.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
