{
  "name": "@opening-cross/integrity-service",
  "version": "0.1.0",
  "private": true,
  "description": "Processes built on the integrity analysis: the organic-volume attester, which measures a governed cross's organic volume (funding clusters, Jito bundle evidence, conflicts) and posts only its lower bound to cross_graduate when the guard passes (ADR-0950), and the cited-brief writer service (ADR-0953).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:volume": "tsx src/volume-main.ts",
    "start:brief": "tsx src/brief-main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@opening-cross/cross-graduate-client": "workspace:*",
    "@opening-cross/indexer": "workspace:*",
    "@opening-cross/integrity": "workspace:*",
    "@opening-cross/keeper": "workspace:*",
    "@opening-cross/reliability": "workspace:*",
    "@opening-cross/research": "workspace:*",
    "@opening-cross/sdk": "workspace:*",
    "@solana/kit": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
