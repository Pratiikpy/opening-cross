# Copy to .env on the server and fill in. Nothing in this file is a secret; the keypairs live in ./.secrets.

# Postgres password (generate one: openssl rand -hex 24).
POSTGRES_PASSWORD=

# Public hostname Caddy gets a Let's Encrypt certificate for, e.g. 20-1-2-3.sslip.io for the server at 20.1.2.3.
SITE_HOST=

# Cluster the indexer, API, keeper and promiser follow.
NETWORK=devnet
RPC_URL=https://api.devnet.solana.com

# Public key of ./.secrets/promiser.json (solana address -k ./.secrets/promiser.json). The API publishes it so a
# stranger can check a signed price band against the right key.
PROMISE_SIGNER=

# Browsers allowed to call the API. Empty allows any origin; set it to the web app's origin(s), comma-separated.
CORS_ORIGINS=

# The keeper acts only on crosses made by these creators (comma-separated addresses). Required.
KEEPER_CREATORS=

# Wallets we operate, comma-separated addresses (public keys of the keeper, promiser, market maker and team wallets). The
# external-flow scorecard (/v1/metrics/external-flow) leaves their orders out of the "external" figures. Leave it empty and
# only each cross's creator, proceeds recipient, integrator and fee recipient are excluded, which makes the external figures
# an upper bound. A value that is not a Solana address stops the API from starting.
OWN_WALLETS=

# Optional tuning (defaults shown).
RATE_LIMIT_PER_MINUTE=600
INDEXER_POLL_MS=8000
INDEXER_RECONCILE_EVERY=20
KEEPER_PASS_MS=15000
PROMISER_ROUND_MS=15000
PROMISER_ANCHOR_MS=600000

# Premium monitor: always measures mainnet. A paid endpoint is better than the public one; restrict the universe with
# a comma list of tickers to lower the load.
PREMIUM_RPC_URL=https://api.mainnet-beta.solana.com
PREMIUM_ROUND_MS=60000
PREMIUM_TICKERS=

# ---- Optional services (docker compose --profile <name> up -d). See docs/CONFIGURATION.md for every variable.

# stream: a bearer token clients must send; empty leaves the stream open on the host's localhost only.
STREAM_TOKEN=

# billing: the token subscriptions are paid in, the wallet that receives them, and ./.secrets/billing.json (signs invoices only).
BILLING_MINT=
REVENUE_WALLET=

# ops: JSON list of console logins, each with the sha-256 of that person's token. Without any, every request is refused.
#   [{"name":"alice","role":"admin","sha256":"<printf %s "$TOKEN" | sha256sum>"}]  roles: viewer, reviewer, admin
OPS_TOKENS=
# Secret in the path of the monitor's webhook (/v1/ops/hooks/monitor/<secret>). Empty turns the webhook off.
OPS_WEBHOOK_SECRET=

# monitor: "yes" arms the automatic pause (needs ./.secrets/guardian.json, the protocol's guardian key). Empty is a dry run.
MONITOR_ARM=
MONITOR_WEBHOOK_URL=
MONITOR_EXPECT_ADMIN=
MONITOR_EXPECT_GUARDIAN=
MONITOR_EXPECT_FEE_RECIPIENT=

# api additions: addresses whose backing attestations count; addresses known to fund many unrelated wallets (an exchange, a faucet).
BACKING_ATTESTERS=
INTEGRITY_SERVICE_FUNDERS=
