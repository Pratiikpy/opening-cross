{
  "name": "@opening-cross/devnet-proofs",
  "private": true,
  "description": "Devnet proofs for the Meteora DBC design (docs/ROADMAP.md M1). Each run sends real devnet transactions and writes signatures to docs/evidence.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "dp:dbc": "tsx src/dbc-hook-proof.ts",
    "dp:acl": "tsx src/token-acl-proof.ts",
    "dp:core": "tsx src/core-e2e.ts",
    "dp:presale": "tsx src/presale-vault-proof.ts",
    "dp:latency": "tsx src/latency-proof.ts",
    "dp:oracle": "tsx src/oracle-mainnet.ts",
    "dp:oracle-pull": "tsx src/oracle-pull.ts",
    "dp:volfee": "tsx src/volatility-fee-proof.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@meteora-ag/presale": "^0.1.1",
    "@opening-cross/adapters": "workspace:*",
    "@opening-cross/cross-core-client": "workspace:*",
    "@opening-cross/cross-gate-client": "workspace:*",
    "@opening-cross/sdk": "workspace:*",
    "@opening-cross/verifier": "workspace:*",
    "@pythnetwork/hermes-client": "^3.1.0",
    "@pythnetwork/pyth-solana-receiver": "^0.16.0",
    "@solana-program/system": "0.14.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.4.0",
    "@solana/spl-token": "0.4.14",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/token-acl-sdk": "0.4.0",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
