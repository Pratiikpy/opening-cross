{
  "name": "@opening-cross/surfpool-tests",
  "private": true,
  "description": "Opening Cross programs on a Surfpool surfnet: the real binaries at their real addresses, real transactions over JSON-RPC, a clock that can be moved. Whole flows and the refusals of single instructions, each read back from chain state.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "surfnet": "surfpool start --offline --no-tui --no-studio --no-deploy -p 18899 -w 18900",
    "test": "vitest run"
  },
  "devDependencies": {
    "@opening-cross/cross-calendar-client": "workspace:*",
    "@opening-cross/cross-core-client": "workspace:*",
    "@opening-cross/sdk": "workspace:*",
    "@opening-cross/verifier": "workspace:*",
    "@solana-program/system": "0.14.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.4.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
