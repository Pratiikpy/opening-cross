{
  "name": "@opening-cross/cross-gate-client",
  "version": "0.1.0",
  "description": "Generated @solana/kit client for the cross_gate program (transfer hook + Token ACL gate).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratiikpy/opening-cross.git",
    "directory": "packages/cross-gate-client"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "idl"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:svm": "vitest run --config vitest.svm.config.ts",
    "vendor:web": "node scripts/vendor-web.mjs"
  },
  "dependencies": {
    "@solana/kit": "8.4.0",
    "@solana/program-client-core": "8.4.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
