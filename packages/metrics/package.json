{
  "name": "@opening-cross/metrics",
  "version": "0.1.0",
  "description": "Measurement for Opening Cross: a versioned registry of metric specifications, and an A/B experiment library with sticky assignment, sample-ratio checks, exact sample-size planning and analyses that refuse to call a result before its planned sample.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratiikpy/opening-cross.git",
    "directory": "packages/metrics"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "docs": "tsx scripts/gen-docs.ts",
    "simulate": "tsx scripts/simulate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@opening-cross/promises": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
