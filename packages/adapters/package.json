{
  "name": "@opening-cross/adapters",
  "version": "0.1.0",
  "description": "Settlement adapters for Opening Cross: Meteora DBC continuation, DAMM v2 and DLMM, and Raydium CPMM, all opened at the clearing price.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratiikpy/opening-cross.git",
    "directory": "packages/adapters"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@opening-cross/cross-gate-client": "workspace:*",
    "@opening-cross/cross-settle-client": "workspace:*",
    "@opening-cross/sdk": "workspace:*",
    "@solana-program/token": "0.16.0",
    "@solana/kit": "8.4.0",
    "@solana/web3.js": "1.98.4",
    "@sqds/multisig": "2.1.4",
    "bn.js": "5.2.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
