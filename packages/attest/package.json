{
  "name": "@opening-cross/attest",
  "version": "0.1.0",
  "description": "Signed documents for Opening Cross: a canonical JSON body, its sha-256 id and an Ed25519 signature by a published key, with a domain prefix so a signature for one kind of document is never valid for another.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratiikpy/opening-cross.git",
    "directory": "packages/attest"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@opening-cross/promises": "workspace:*",
    "@solana/kit": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
