  },
  "dependencies": {
    "@opening-cross/cross-core-client": "workspace:*",
    "@solana/kit": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
