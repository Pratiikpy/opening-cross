{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opening-cross:schema:receipt:v1",
  "title": "Opening Cross receipt, version 1",
  "description": "A receipt restates the result the chain recorded for a settled cross, the verdict of the independent recomputation, and the transactions that recorded the result. It is bound to its content by the SHA-256 of its canonical JSON (docs/standard/receipt-v1.md); it is not signed, and it is not a zero-knowledge or multi-party proof. The document holds no timestamp and no randomness: the same cross always yields the same bytes.",
  "type": "object",
  "required": ["schema", "network", "program", "cross", "market", "result", "verification", "orders", "anchors", "wallet", "limits"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "opening-cross/receipt/v1" },
    "network": { "type": "string", "minLength": 1, "description": "The cluster the API follows, as it reports it." },
    "program": { "$ref": "#/$defs/address" },
    "cross": { "$ref": "#/$defs/address" },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priceScale", "baseDecimals", "quoteDecimals"],
      "properties": {
        "priceScale": { "$ref": "#/$defs/u64" },
        "baseDecimals": { "type": "integer", "minimum": 0, "maximum": 255 },
        "quoteDecimals": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "result": {
      "description": "The on-chain outcome (the `onchain` object of the fairness proof), with the no-print reason as its name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "printed", "price", "matched", "rationed", "noPrintReason"],
      "properties": {
        "state": { "enum": ["Cleared", "NoPrint", "Finalized"] },
        "printed": { "type": "boolean" },
        "price": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "matched": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "rationed": { "enum": ["none", "buy", "sell", null] },
        "noPrintReason": { "type": ["string", "null"], "description": "NoCross, BelowMinimumVolume, ImbalanceTooHigh, SettlementExpired, OracleDivergence or OracleUnavailable; a reason this version does not know is written as `reason <index>`." }
      },
      "if": { "type": "object", "properties": { "printed": { "const": true } }, "required": ["printed"] },
      "then": { "type": "object", "properties": { "price": { "type": "string" }, "matched": { "type": "string" }, "noPrintReason": { "type": "null" } } },
      "else": { "type": "object", "properties": { "price": { "type": "null" }, "matched": { "type": "null" } } }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "recomputedMatchesChain", "proofSchema", "proofSha256"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "recomputedMatchesChain": { "type": "boolean", "description": "The `verified` field of the fairness proof." },
        "proofSchema": { "const": "opening-cross/fairness-proof/v1" },
        "proofSha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the canonical JSON of the whole fairness proof this receipt was built from." }
      }
    },
    "orders": {
      "description": "Counts over every order of the cross, or null when the index could not be read.",
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["total", "filled"], "properties": { "total": { "type": "integer", "minimum": 0 }, "filled": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "anchors": {
      "description": "The transactions that recorded the result, from the cross's event log.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "signature", "slot", "time"],
        "properties": {
          "event": { "enum": ["CrossCleared", "CrossFinalized"] },
          "signature": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,90}$" },
          "slot": { "$ref": "#/$defs/u64" },
          "time": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "wallet": {
      "description": "Present for a wallet receipt: that wallet's orders in this cross.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "orders"],
          "properties": {
            "owner": { "$ref": "#/$defs/address" },
            "orders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["order", "index", "side", "escrow", "limitPrice", "quantity", "status", "fill", "baseOut", "quoteOut", "fee"],
                "properties": {
                  "order": { "$ref": "#/$defs/address" },
                  "index": { "type": "integer", "minimum": 0 },
                  "side": { "enum": ["buy", "sell"] },
                  "escrow": { "$ref": "#/$defs/u64" },
                  "limitPrice": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
                  "quantity": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
                  "status": { "enum": ["committed", "revealed", "cancelled", "claimed"] },
                  "fill": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
                  "baseOut": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
                  "quoteOut": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
                  "fee": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] }
                }
              }
            }
          }
        }
      ]
    },
    "limits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "What the receipt does not show, carried inside it so it cannot be quoted without it." }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$" },
    "u64": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
