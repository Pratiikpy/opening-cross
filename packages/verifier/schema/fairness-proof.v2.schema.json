{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opening-cross:schema:fairness-proof:v2",
  "title": "Opening Cross fairness proof, version 2",
  "description": "The document served by GET /v1/crosses/:address/proof for a cross that carries rules (OCIP-1 section 13.3 and ADR-0450 to ADR-0462). It is version 1 with the cross's rules, the draw and the allocation figures added; a cross created by the program deployed before the rules extension still gets version 1, unchanged. Integers that may exceed 2^53 are decimal strings. Optional fields may be added to version 2 without a new version, so unknown properties are allowed; every property listed here is required and typed.",
  "type": "object",
  "required": ["schema", "program", "cross", "state", "params", "book", "onchain", "recomputed", "verified", "notes", "rules"],
  "properties": {
    "schema": { "const": "opening-cross/fairness-proof/v2" },
    "program": { "$ref": "#/$defs/address" },
    "cross": { "$ref": "#/$defs/address" },
    "state": { "enum": ["Live", "Cleared", "NoPrint", "Finalized"] },
    "params": {
      "type": "object",
      "required": ["minPrice", "tick", "ticks", "priceScale", "referencePrice", "minMatched", "maxImbalanceBps", "oracleGuard"],
      "properties": {
        "minPrice": { "$ref": "#/$defs/u64" },
        "tick": { "$ref": "#/$defs/u64" },
        "ticks": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "priceScale": { "$ref": "#/$defs/u64" },
        "referencePrice": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "minMatched": { "$ref": "#/$defs/u64" },
        "maxImbalanceBps": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 10000 }, { "type": "null" }] },
        "oracleGuard": { "type": "boolean" }
      }
    },
    "book": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["price", "buy", "sell", "buyOrders", "sellOrders"],
        "properties": {
          "price": { "$ref": "#/$defs/u64" },
          "buy": { "$ref": "#/$defs/u64" },
          "sell": { "$ref": "#/$defs/u64" },
          "buyOrders": { "type": "integer", "minimum": 0 },
          "sellOrders": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "onchain": {
      "type": "object",
      "required": ["printed", "price", "matched", "rationed", "noPrintReason"],
      "properties": {
        "printed": { "type": "boolean" },
        "price": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "matched": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "rationed": { "enum": ["none", "buy", "sell", null] },
        "noPrintReason": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "recomputed": {
      "type": "object",
      "required": ["printed", "price", "matched", "rationed", "noPrintReason"],
      "properties": {
        "printed": { "type": "boolean" },
        "price": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "matched": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "rationed": { "enum": ["none", "buy", "sell", null] },
        "noPrintReason": { "enum": ["NoCross", "BelowMinimumVolume", "ImbalanceTooHigh", "BelowMinimumRaise", "FloatTooLow", "FdvTooHigh", "PriceMoved", null] }
      }
    },
    "verified": { "type": "boolean", "description": "False for a cross that has not cleared, and false when any check in rules.checks failed." },
    "notes": { "type": "array", "items": { "type": "string" } },
    "rules": {
      "type": "object",
      "required": ["ending", "checks", "limits", "supplyCap", "minRaiseQuote", "totalSupply", "minFloatBps", "maxFdvX100", "anchorPrice", "moveBps", "reserveBps", "lotteryUnit", "insiders", "draw", "allocation"],
      "properties": {
        "ending": {
          "description": "The ending period and what the draw fixed; null when the cross has neither an ending period nor an extension.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["endingSecs", "buckets", "cancelCutoffSecs", "randomEnd", "startsAt", "lastCountedBucket", "extension"],
              "properties": {
                "endingSecs": { "type": "integer", "minimum": 0 },
                "buckets": { "type": "integer", "minimum": 0, "maximum": 8 },
                "cancelCutoffSecs": { "type": "integer", "minimum": 0 },
                "randomEnd": { "type": "boolean" },
                "startsAt": { "oneOf": [{ "type": "string", "pattern": "^-?[0-9]{1,19}$" }, { "type": "null" }] },
                "lastCountedBucket": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 7 }, { "type": "null" }] },
                "extension": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "object", "required": ["minSecs", "maxSecs", "used", "epoch"], "properties": { "minSecs": { "type": "integer", "minimum": 0 }, "maxSecs": { "type": "integer", "minimum": 0 }, "used": { "type": "boolean" }, "epoch": { "type": "integer", "minimum": 0 } } }
                  ]
                }
              }
            }
          ]
        },
        "checks": {
          "description": "What was re-derived from the account beyond the clearing itself. ok is null when the inputs the check needs were not supplied or no longer exist.",
          "type": "array",
          "items": { "type": "object", "required": ["name", "ok", "detail"], "properties": { "name": { "type": "string" }, "ok": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] }, "detail": { "type": "string" } } }
        },
        "limits": { "description": "What this proof does not establish.", "type": "array", "items": { "type": "string" } },
        "supplyCap": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "minRaiseQuote": { "$ref": "#/$defs/u64" },
        "totalSupply": { "$ref": "#/$defs/u64" },
        "minFloatBps": { "type": "integer", "minimum": 0 },
        "maxFdvX100": { "type": "integer", "minimum": 0 },
        "anchorPrice": { "$ref": "#/$defs/u64" },
        "moveBps": { "type": "integer", "minimum": 0 },
        "reserveBps": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 10000 }, "minItems": 3, "maxItems": 3 },
        "lotteryUnit": { "$ref": "#/$defs/u64" },
        "insiders": { "type": "integer", "minimum": 0, "maximum": 8 },
        "draw": {
          "type": "object",
          "required": ["epoch", "seed", "endBucket"],
          "properties": {
            "epoch": { "type": "integer", "minimum": 0 },
            "seed": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
            "endBucket": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 7 }, { "type": "null" }] }
          }
        },
        "allocation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["classQty", "tickets", "rho", "insiderUpperBound", "counted"],
              "properties": {
                "classQty": { "type": "array", "items": { "$ref": "#/$defs/u64" }, "minItems": 3, "maxItems": 3 },
                "tickets": { "type": "integer", "minimum": 0 },
                "rho": { "type": "integer", "minimum": 0 },
                "insiderUpperBound": { "$ref": "#/$defs/u64" },
                "counted": { "$ref": "#/$defs/u64" }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "onchain": { "type": "object", "properties": { "printed": { "const": true } } } }, "required": ["onchain"] },
      "then": { "type": "object", "properties": { "onchain": { "type": "object", "properties": { "price": { "type": "string" }, "matched": { "type": "string" }, "rationed": { "type": "string" }, "noPrintReason": { "type": "null" } } } } },
      "else": { "type": "object", "properties": { "onchain": { "type": "object", "properties": { "price": { "type": "null" }, "matched": { "type": "null" }, "rationed": { "type": "null" } } } } }
    },
    {
      "if": { "type": "object", "properties": { "recomputed": { "type": "object", "properties": { "printed": { "const": true } } } }, "required": ["recomputed"] },
      "then": { "type": "object", "properties": { "recomputed": { "type": "object", "properties": { "price": { "type": "string" }, "matched": { "type": "string" }, "rationed": { "type": "string" }, "noPrintReason": { "type": "null" } } } } },
      "else": { "type": "object", "properties": { "recomputed": { "type": "object", "properties": { "price": { "type": "null" }, "matched": { "type": "null" }, "rationed": { "type": "null" } } } } }
    },
    {
      "if": { "type": "object", "properties": { "state": { "const": "Live" } }, "required": ["state"] },
      "then": { "type": "object", "properties": { "verified": { "const": false } } }
    }
  ],
  "$defs": {
    "address": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$" },
    "u64": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "description": "An unsigned 64-bit integer as a decimal string." }
  }
}
