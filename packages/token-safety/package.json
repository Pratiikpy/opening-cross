{
  "name": "@opening-cross/token-safety",
  "version": "0.1.0",
  "description": "Reads a mint's Token-2022 extensions and reports issuer powers that put pooled or escrowed balances at risk.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:mainnet": "vitest run test/mainnet"
  },
  "dependencies": {
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.4.0",
    "@solana/sysvars": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
