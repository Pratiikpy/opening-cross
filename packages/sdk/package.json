{
  "name": "@opening-cross/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Opening Cross: addresses, commitments and instruction builders for every step of a cross.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratiikpy/opening-cross.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@opening-cross/cross-core-client": "workspace:*",
    "@opening-cross/cross-gate-client": "workspace:*",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
